#!/bin/sh

# Unload daemon service
if [ -f "/var/jb/Library/LaunchDaemons/com.kurishu.contrainstalld.plist" ]; then
    launchctl unload /var/jb/Library/LaunchDaemons/com.kurishu.contrainstalld.plist 2>/dev/null
elif [ -f "/Library/LaunchDaemons/com.kurishu.contrainstalld.plist" ]; then
    launchctl unload /Library/LaunchDaemons/com.kurishu.contrainstalld.plist 2>/dev/null
fi

# Terminate any lingering daemon process
killall -9 contrainstalld 2>/dev/null

# Clean up staging and application support data on purge
if [ "$1" = "purge" ]; then
    rm -rf /var/jb/Library/com.kurishu.contrainstalld-Staging 2>/dev/null
    rm -rf "/var/jb/Library/Application Support/com.kurishu.contrainstalld" 2>/dev/null
    rm -rf /Library/com.kurishu.contrainstalld-Staging 2>/dev/null
    rm -rf "/Library/Application Support/com.kurishu.contrainstalld" 2>/dev/null
fi

# Request SpringBoard restart (respring) when removing via Sileo / Cydia / Zebra
if [ -n "$CYDIA" ]; then
    CYDIA_FD=$(echo "$CYDIA" | cut -d' ' -f1)
    eval "echo 'finish:restart' >&$CYDIA_FD"
elif [ -n "$SILEO" ]; then
    SILEO_FD=$(echo "$SILEO" | cut -d' ' -f1)
    eval "echo 'finish:restart' >&$SILEO_FD"
fi

exit 0
